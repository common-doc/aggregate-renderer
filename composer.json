{
    "name": "common-doc/aggregate-renderer",
    "description": "Renders every onboarded documentation project and version into one aggregate site tree.",
    "license": "BSD-3-Clause",
    "keywords": [
        "common-doc",
        "aggregate",
        "documentation",
        "markdown"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "extra": {
        "laminas": {
            "config-provider": "CommonDoc\\Aggregate\\ConfigProvider"
        }
    },
    "require": {
        "php": "~8.4.1 || ~8.5.0 || ~8.6.0",
        "common-doc/commondoc": "^1.0",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-servicemanager": "^4.5",
        "laminas/laminas-view": "^3.1",
        "league/commonmark": "^2.10",
        "mezzio/mezzio-laminasviewrenderer": "^3.1",
        "mezzio/mezzio-template": "^3.1",
        "psr/container": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.4.4",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "CommonDoc\\Aggregate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CommonDocTest\\Aggregate\\": "test/unit/",
            "CommonDocTestIntegration\\Aggregate\\": "test/integration/"
        }
    },
    "bin": [
        "bin/aggregate-render"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "laminas/laminas-component-installer": true
        },
        "github-protocols": [
            "https"
        ]
    },
    "scripts": {
        "test": "phpunit --no-coverage --colors=always --testsuite \"unit test\"",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": "@test && @test-integration && @mutation-test"
    }
}
