?>
<?php $this->headTitle('Documentation'); ?>
<main class="site-index">
    <h1>Documentation</h1>
    <ul class="projects">
        <?php foreach ($entries as $project) : ?>
        <li class="project">
            <h2><?= $this->escapeHtml($project['name']) ?></h2>
            <ul class="versions">
                <?php foreach ($project['versions'] as $version) : ?>
                <li class="version">
                    <a href="<?= $this->escapeHtml($version['address']) ?>"><?= $this->escapeHtml($version['version']) ?></a>
                </li>
                <?php endforeach ?>
            </ul>
        </li>
        <?php endforeach ?>
    </ul>
</main>
